{
    "name": "templates",
    "version": "0.0.1",
    "description": "Templates",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "scripts": {
        "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf",
        "build:cf": "npm run build:ui5",
        "build:ui5": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo"
    },
    "devDependencies": {
        "@openui5/ts-types-esm": "^1.115.1",
        "@sap-ux/ui5-middleware-fe-mockserver": "^2.2.5",
        "@sap/ux-ui5-tooling": "^1.11.4",
        "@sapui5/ts-types-esm": "^1.115.1",
        "@ui5/cli": "^3.7.3",
        "mbt": "^1.2.24",
        "ui5-task-zipper": "^3.1.0",
        "ui5-tooling-transpile": "^3.2.7",
        "@sap/ui5-builder-webide-extension": "^1.1.8"
    }
}
